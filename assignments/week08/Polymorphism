class Animal:
	def move(self):
		raise NotImplementedError("Subclasses must implement move().")

class Fish(Animal):
	def move(self):
		print("The fish swims.")

class Bird(Animal):
	def move(self):
		print("The bird flies.")

class Dog(Animal):
	def move(self):
		print("The dog runs.")

def make_move(animal):
	animal.move()

for animal in (Fish(), Bird(), Dog()):
	make_move(animal)
