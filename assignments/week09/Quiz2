import random

def get_parity_hint(number):
	if number % 2 == 0:
		return "HINT: The number is even"
	return "HINT: The number is odd"

def get_divisibility_hint(number):
	if number % 3 == 0:
		return "HINT: The number is divisible by 3"
	if number % 5 == 0:
		return "HINT: The number is divisible by 5"
	return "HINT: The number is NOT divisible by 3 or 5"

def get_range_hint(number, current_min=1, current_max=100):
	"""Return a 25-number range containing *number*."""
	current_min = max(1, current_min)
	current_max = min(100, current_max)
	window_size = min(25, current_max - current_min + 1)
	start = max(current_min, min(number - window_size // 2,
								 current_max - window_size + 1))
	end = start + window_size - 1
	return f"HINT: The number is between {start} and {end}"

def get_thefirst_digit_hint(number):
	"""Return a hint containing the first digit of the number."""
	return f"HINT: The first digit is {str(abs(number))[0]}"

def play_game():
	number = random.randint(1, 100)
	attempts = 0
	wrong_guesses = 0
	print("=== Enhanced GUESSING GAME ===")
	print("Guess my number between 1 and 100!")
	print("You have unlimited attempts.")

	while True:
		try:
			guess = int(input(f"\nAttempt {attempts + 1} - Enter your guess: "))
		except ValueError:
			print("Please enter a whole number.")
			continue
		if not 1 <= guess <= 100:
			print("Please enter a number between 1 and 100.")
			continue
		attempts += 1
		if guess == number:
			print(f"Congratulations! You won in {attempts} attempts!")
			return
		wrong_guesses += 1
		print("Too low! Try again." if guess < number else "Too high! Try again.")
		if wrong_guesses >= 3:
			print(get_parity_hint(number))
		if wrong_guesses >= 5:
			print(get_divisibility_hint(number))
		if wrong_guesses >= 7:
			print(get_range_hint(number))
		if wrong_guesses >= 10:
			print(get_thefirst_digit_hint(number))

if __name__ == "__main__":
	play_game()
