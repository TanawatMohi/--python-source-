print("=== PERSONAL INFORMATION VALIDATOR ===")

name = input("Enter your name: ")
age_text = input("Enter your age: ")
phone = input("Enter your phone number: ")
name_is_valid = bool(name) and all(part.isalpha() for part in name.split())

try:
	age = int(age_text)
	age_is_valid = 18 <= age <= 65
except ValueError:
	age = None
	age_is_valid = False

phone_is_valid = len(phone) == 10 and phone.isdigit()

print("\nValidation Results:")
if name_is_valid:
	print("Name: Valid (contains only letters and spaces)")
else:
	print("Name: Invalid (use only letters and spaces)")

if age_is_valid:
	print("Age: Valid ({} years old)".format(age))
else:
	print("Age: Invalid (must be between 18 and 65)")

if phone_is_valid:
	print("Phone: Valid (10-digit number)")
else:
	print("Phone: Invalid (must contain exactly 10 digits)")

print("\nFormatted Information:")
print("Name: {}".format(name.upper()))

if age is not None and 18 <= age <= 30:
	age_group = "Young Adult (18-30)"
elif age is not None and 31 <= age <= 45:
	age_group = "Adult (31-45)"
elif age is not None and 46 <= age <= 65:
	age_group = "Mature Adult (46-65)"
else:
	age_group = "Unavailable"

print("Age Group: {}".format(age_group))
if phone_is_valid:
	print("Phone: +91-{}".format(phone))
else:
	print("Phone: {}".format(phone))
