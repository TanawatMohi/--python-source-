def get_temperatures():
	temperatures = []
	for day in range(1, 8):
		temperatures.append(float(input(f"Enter temperature for day {day}: ")))
	return temperatures

def analyze_temps(temp_list):
	average = sum(temp_list) / len(temp_list)
	highest = max(temp_list)
	lowest = min(temp_list)
	return average, highest, lowest

def display_analysis(avg, high, low):
	print("Temperature Analysis for the Week:")
	print(f"Average: {avg:g} C")
	print(f"Highest: {high:g} C")
	print(f"Lowest: {low:g} C")

if __name__ == "__main__":
	temperatures = get_temperatures()
	average, highest, lowest = analyze_temps(temperatures)
	display_analysis(average, highest, lowest)
