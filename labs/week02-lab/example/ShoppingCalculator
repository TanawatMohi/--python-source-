item_price = float(input("Enter item price: "))
quantity = int(input("Enter quantity: "))
discount_percent = float(input("Enter discount %: "))
tax_percent = float(input("Enter tax %: "))

subtotal = item_price * quantity
discount_amount = subtotal * discount_percent / 100
price_after_discount = subtotal - discount_amount
tax_amount = price_after_discount * tax_percent / 100
total = price_after_discount + tax_amount

print("\nItemized Receipt")
print(f"Item price: ${item_price:.2f}")
print(f"Quantity: {quantity}")
print(f"Subtotal: ${subtotal:.2f}")
print(f"Discount ({discount_percent:.2f}%): -${discount_amount:.2f}")
print(f"Price after discount: ${price_after_discount:.2f}")
print(f"Tax ({tax_percent:.2f}%): +${tax_amount:.2f}")
print(f"Total: ${total:.2f}")
